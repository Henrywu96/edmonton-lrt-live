{
  "name": "edmonton-lrt-live",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Edmonton LRT trains moving on a live map, placed from the ETS GTFS timetable.",
  "scripts": {
    "data": "node scripts/build-gtfs.mjs",
    "predev": "node scripts/build-gtfs.mjs --if-missing",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "maplibre-gl": "5.24.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "0.160.0",
    "@vitejs/plugin-react": "^4.6.0",
    "jszip": "^3.10.1",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
